{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "django-ai-plugins": {
      "source": {
        "source": "github",
        "repo": "vintasoftware/django-ai-plugins"
      }
    }
  },
  "enabledPlugins": {
    "django-safe-migration@django-ai-plugins": true
  }
}
