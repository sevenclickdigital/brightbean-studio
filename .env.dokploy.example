# Dokploy environment template — paste into the Dokploy app's "Environment"
# tab and fill in the values. Dokploy writes that tab to a .env next to the
# compose file, which is what docker-compose.dokploy.yml reads.
#
# NEVER commit a filled-in copy of this file. Real values belong only in
# Dokploy's Environment tab (.env is gitignored for this reason).
#
# This is the Dokploy-specific subset. For the full list of options (every
# platform credential, publishing tuning, Intelligence, MCP OAuth), see
# .env.example — anything there can be added here verbatim.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# No default — Django refuses to boot without it. 50+ random chars.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Salt for deriving the field-encryption key (stored OAuth tokens) and for
# API-key HMAC peppering. Generate it the same way as SECRET_KEY.
#
# Unlike SECRET_KEY this does NOT fail at startup when missing — the app boots
# fine and then raises the first time something is encrypted, i.e. when you
# connect a platform account. Set it before the first deploy.
#
# WARNING: the encryption key is derived from SECRET_KEY + ENCRYPTION_KEY_SALT.
# Changing EITHER value makes every already-stored platform token impossible to
# decrypt, and all connected accounts must be reconnected. Treat both as
# write-once per deployment.
ENCRYPTION_KEY_SALT=

# Password for the postgres service in docker-compose.dokploy.yml. Ignored if
# you set DATABASE_URL below to an external database.
POSTGRES_PASSWORD=

# Your public hostname, no scheme. Comma-separated if more than one.
ALLOWED_HOSTS=studio.seudominio.com

# Public URL of this deployment, with https://. Used to build OAuth callback
# and webhook URLs, so it must match the domain configured in Dokploy exactly.
APP_URL=https://studio.seudominio.com

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------

# Keep false in production. config.settings.production forces DEBUG off
# anyway, but leaving this true is a footgun if the settings module changes.
DEBUG=false

# Set only to use a database outside the compose file (e.g. one provisioned in
# Dokploy's "Databases" tab). When set it takes precedence over the bundled
# postgres service — remove that service from the compose file if unused.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Who may create an account: open | invite | closed
# A self-hosted install must be reachable from the internet for OAuth
# callbacks and webhooks, so "open" means open to the world. Use "closed" and
# create accounts in /admin/ if this is a private instance.
SIGNUP_MODE=closed

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------

# local = uploads on the media_data volume, served by Django.
#
# Caveat for this setup: docker-compose.dokploy.yml has no Caddy (Dokploy's
# Traefik is the proxy), so uploads are served by Django's static view, which
# does not implement byte-range requests. Video cannot be seeked and Safari may
# refuse to play it. Switch to s3 if you serve video.
STORAGE_BACKEND=local

# Must stay /app/media: that is where the media_data volume is mounted.
MEDIA_ROOT=/app/media
SERVE_MEDIA=true

# Unused here (no Caddy in the Dokploy compose) — kept so the file stays a
# drop-in match for .env.example.
CADDY_MEDIA_ROOT=/app/media

# Fill these in only when STORAGE_BACKEND=s3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto
# Bytes an object may occupy in memory before the read spools to disk. Leave
# alone: django-storages' own default (0) means "never spool", which holds
# whole videos in RAM and is how a small container runs out of memory.
AWS_S3_MAX_MEMORY_SIZE=2097152

# ---------------------------------------------------------------------------
# EMAIL — needed for invitations, password resets and notifications.
# ---------------------------------------------------------------------------
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@seudominio.com

# ---------------------------------------------------------------------------
# GOOGLE AUTH — user login/signup. Separate from the platform credentials.
# ---------------------------------------------------------------------------
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
CUSTOM_SIGNUP_URL=

# ---------------------------------------------------------------------------
# PLATFORM CREDENTIALS
#
# Optional at deploy time — add only the platforms you actually connect, then
# redeploy. Can also be set per organization in /admin/ -> Platform
# credentials; values here take precedence. See .env.example and the README
# for the per-platform setup (especially LinkedIn, which has two paths).
# ---------------------------------------------------------------------------
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_FACEBOOK_CONFIG_ID=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=

# Optional — enables stock-photo search in the composer.
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# INBOUND WEBHOOKS — set the matching values in each platform's app console.
# ---------------------------------------------------------------------------
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# CACHE — optional.
#
# Left empty, Django uses an in-process LocMemCache: not shared between the
# app and worker containers, and a separate copy per gunicorn worker. That is
# a working default, not a broken one. Point this at a Redis instance (e.g.
# one from Dokploy's "Databases" tab) to get a shared cache instead.
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# MONITORING — optional.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling keeps stack samples in memory; turn it on only when chasing a
# regression on a container with headroom.
SENTRY_PROFILES_SAMPLE_RATE=0.0
